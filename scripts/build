#!/bin/bash -e

source $(dirname $0)/version
cd $(dirname $0)/..

SIMULATOR_PATCH="patches/simulator.patch"
if git apply --reverse --check "$SIMULATOR_PATCH" >/dev/null 2>&1; then
    echo "Simulator vendor patch is already applied"
elif git apply --check "$SIMULATOR_PATCH"; then
    echo "Applying simulator vendor patch"
    git apply "$SIMULATOR_PATCH"
    echo "Simulator vendor patch is applied"
else
    echo "ERROR: Simulator vendor patch no longer applies. Refresh $SIMULATOR_PATCH after updating dependencies." >&2
    exit 1
fi

mkdir -p bin
if [ "$(uname)" = "Linux" ]; then
    OTHER_LINKFLAGS="-extldflags -static -s"
fi

LINKFLAGS="-X github.com/rancher/support-bundle-kit/cmd.AppVersion=$VERSION
           -X github.com/rancher/support-bundle-kit/cmd.GitCommit=$COMMIT"

CGO_ENABLED=0 GOARCH=amd64 GO111MODULE=on go build -ldflags "$LINKFLAGS $OTHER_LINKFLAGS" -mod=vendor -o bin/support-bundle-kit-amd64
CGO_ENABLED=0 GOARCH=arm64 GO111MODULE=on go build -ldflags "$LINKFLAGS $OTHER_LINKFLAGS" -mod=vendor -o bin/support-bundle-kit-arm64
CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 GO111MODULE=on go build -ldflags "$LINKFLAGS" -mod=vendor -o bin/support-bundle-kit-darwin-arm64

# non-go scripts
cp hack/* bin
